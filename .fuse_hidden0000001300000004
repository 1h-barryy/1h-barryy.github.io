<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Page not found — Barry Yuan</title>
<meta name="robots" content="noindex">
<script>
/* Old URLs from before the site moved into folders. GitHub Pages serves this
   page for any missing URL, so it forwards the old ones to their new homes. */
(function () {
  var p;
  try { p = decodeURIComponent(location.pathname); } catch (e) { return; }
  var tail = location.search + location.hash;

  // Pages that moved into folders.
  var moved = {
    "/about.html": "/about/",
    "/contact.html": "/contact/",
    "/portfolio.html": "/portfolio/",
    "/thought-path.html": "/portfolio/thought-path/",
    "/barrymade.html": "/barrymade/",
    "/barrymade-parallel-crossy-road.html": "/barrymade/parallel-crossy-road/",
    "/barrymade-financial-analyst-arcade.html": "/barrymade/financial-analyst-arcade/",
    "/financial-analyst-arcade.html": "/barrymade/financial-analyst-arcade/play/"
  };
  if (moved.hasOwnProperty(p)) { location.replace(moved[p] + tail); return; }

  // Old folders. keepRest: files inside still exist under the new folder.
  var folders = [
    { old: "/BarryMade/Parallel Crossy Road", to: "/barrymade/parallel-crossy-road/play/", keepRest: true },
    { old: "/BarryMade/Financial Analyst Arcade", to: "/barrymade/financial-analyst-arcade/", keepRest: false }
  ];
  for (var i = 0; i < folders.length; i++) {
    var f = folders[i];
    if (p !== f.old && p.indexOf(f.old + "/") !== 0) continue;
    var rest = f.keepRest ? p.slice(f.old.length + 1) : "";
    if (rest === "index.html") rest = "";
    location.replace(f.to + encodeURI(rest) + tail);
    return;
  }
})();
</script>
</head>
<body>
<p>Page not found. <a href="/">Go to the home page</a>.</p>
</body>
</html>
